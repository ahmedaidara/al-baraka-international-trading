rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // MODE DÉVELOPPEMENT — règles assouplies
    // À RESTRICTIF avant la mise en production réelle
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // === USERS ===
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // === PRODUCTS (admin sans login pour le moment) ===
    match /products/{productId} {
      allow read, write: if true;
    }

    // === CATEGORIES ===
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // === EXCHANGE RATES & SETTINGS ===
    match /exchangeRates/{docId} {
      allow read, write: if true;
    }

    match /exchangeSettings/{docId} {
      allow read, write: if true;
    }

    // === PAYMENT METHODS ===
    match /paymentMethods/{methodId} {
      allow read, write: if true;
    }

    // === EXCHANGE REQUESTS ===
    match /exchangeRequests/{requestId} {
      allow read, write: if true;
    }

    // === ORDERS ===
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // === TRACKING EVENTS ===
    match /trackingEvents/{eventId} {
      allow read, write: if true;
    }

    // === NOTIFICATIONS ===
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // === SUPPORT TICKETS ===
    match /supportTickets/{ticketId} {
      allow read, write: if true;
    }

    // === ADMIN LOGS ===
    match /adminActivityLogs/{logId} {
      allow read, write: if true;
    }

    // === APP SETTINGS ===
    match /appSettings/{settingId} {
      allow read, write: if true;
    }

    // Tout le reste ouvert en dev
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
